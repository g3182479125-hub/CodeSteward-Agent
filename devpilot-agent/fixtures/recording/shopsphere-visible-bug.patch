+    def test_in_stock_catalogue_item_has_an_enabled_add_to_cart_button(self):
+        """A product shown as in stock must be purchasable from the catalogue."""
+        body = self.client.get("/c/books-media").get_data(as_text=True)
+        card = re.search(
+            r'<article class="card".*?Atlas of Forgotten Places.*?</article>',
+            body,
+            re.DOTALL,
+        )
+        self.assertIsNotNone(card)
+        self.assertIn("Add to cart", card.group(0))
+        self.assertNotIn("disabled", card.group(0))
+
     def test_missing_product_404s(self):
